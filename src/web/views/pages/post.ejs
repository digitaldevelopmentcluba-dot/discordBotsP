<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<div class="status-section">
    <h2>
        <%= post.title %>
    </h2>

    <span class="news-date">
        <%= post.date.toLocaleString("en-US", {year: "numeric" ,month: "long" ,day: "numeric" ,hour: "2-digit"
            ,minute: "2-digit" }) %>
    </span>
    <span class="news-author">By <%= post.author %></span>

    <% if (post.thumbnail) { %>
        <img class="news-thumb-large" src="<%= post.thumbnail %>" alt="Thumbnail">
        <% } %>

            <div class="news-tags">
                <% post.tags.forEach(tag=> { %>
                    <span class="tag">
                        <%= tag %>
                    </span>
                    <% }) %>
            </div>

            <div class="news-content" id="content"><%- post.content %></div>

            <a href="/news" class="back-link">← Back to News</a>

</div>

<link rel="stylesheet" href="/styles/post.css">

<script>
    window.onload = () => {
        const el = document.getElementById("content");
        el.innerHTML = marked.parse(el.innerHTML);
    };
</script>