<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<div class="status-section" style="margin-top: 20px">
    <h1>Club News & Updates</h1>

    <div class="news-list">
        <% posts.forEach(post=> { %>
            <div class="news-card">
                <% if (post.thumbnail) { %>
                    <div class="thumb-wrapper">
                        <div class="thumb-parallax" style="background-image: url('<%= post.thumbnail %>');">
                        </div>
                    </div>
                    <% } %>

                        <h3>
                            <a href="/news/<%= post.id %>">
                                <%= post.title %>
                            </a>
                        </h3>

                        <div class="author-block">
                            <% if (post.authorThumb) { %>
                                <img class="author-thumb" src="<%= post.authorThumb %>" alt="<%= post.author %>">
                                <% } %>

                                    <div class="author-info">
                                        <span class="news-author">
                                            <%= post.author %>
                                        </span>
                                        <span class="news-date">
                                            <%= post.date.toLocaleString("en-US", {year: "numeric" ,month: "long"
                                                ,day: "numeric" ,hour: "2-digit" ,minute: "2-digit" }); %>
                                        </span>
                                    </div>
                        </div>

                        <div class="news-tags">
                            <% post.tags.forEach(tag=> { %>
                                <span class="tag">
                                    <%= tag %>
                                </span>
                                <% }) %>
                        </div>
            </div>
            <% }) %>
    </div>
</div>

<button id="openCreateMenu" class="create-news-btn">Create Post</button>

<div id="createMenuOverlay" class="create-menu-overlay"></div>

<div id="createMenu" class="create-menu">
    <h2>Create News Post</h2>
    <form action="/news" method="POST" class="create-form">
        <label>
            Title
            <input type="text" name="title" required>
        </label>

        <label>
            Thumbnail URL
            <input type="text" name="thumbnail" placeholder="https://example.com/image.jpg">
        </label>

        <label>
            Tags
            <input type="text" name="tags" placeholder="club, update, event">
        </label>

        <label>
            Content
            <textarea name="content" rows="10" required></textarea>
        </label>

        <button type="submit" class="submit-btn">Publish</button>
    </form>
</div>

<style>
    .create-news-btn {
        position: fixed;
        bottom: 25px;
        right: 25px;

        padding: 14px 22px;
        font-size: 1.1rem;
        border-radius: 10px;
        border: none;

        background: var(--text-color);
        color: var(--bg-color);

        cursor: pointer;
        transition: opacity 0.25s ease, transform 0.25s ease;

        z-index: 1500;
    }

    .create-news-btn:hover {
        opacity: 0.85;
        transform: translateY(-3px);
    }


    .create-menu-overlay {
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
        z-index: 1998;
    }

    .create-menu {
        position: fixed;
        top: 0;
        right: -450px;
        width: 450px;
        height: 100vh;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border-left: 2px solid var(--text-color);
        padding: 25px;
        overflow-y: auto;
        transition: right 0.35s ease;
        z-index: 1999;
    }

    :root.light .create-menu {
        background: rgba(0, 0, 0, 0.4);
    }

    .create-menu.open {
        right: 0;
    }

    .create-menu-overlay.visible {
        opacity: 1;
        pointer-events: all;
    }

    .create-menu h2 {
        color: var(--text-color);
        margin-bottom: 20px;
        text-align: center;
    }

    .create-form {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .create-form label {
        display: flex;
        flex-direction: column;
        color: var(--text-color);
        font-weight: 600;
    }

    .create-form input,
    .create-form textarea {
        margin-top: 6px;
        padding: 10px;
        border-radius: 6px;
        border: 1px solid var(--text-color);
        background: rgba(255, 255, 255, 0.1);
        color: var(--text-color);
    }

    .submit-btn {
        padding: 12px;
        border-radius: 6px;
        border: none;
        background: var(--text-color);
        color: var(--bg-color);
        font-size: 1.1rem;
        cursor: pointer;
        transition: opacity 0.25s ease;
    }

    .submit-btn:hover {
        opacity: 0.8;
    }
</style>


<style>
    .news-list {
        display: flex;
        width: 50%;
        flex-direction: column;
        gap: 20px;
        margin-top: 25px;
        margin-left: auto;
        margin-right: auto;
    }

    .news-card {
        background: rgba(255, 255, 255, 0.5);
        padding: 18px 22px;
        border-radius: 10px;
        opacity: 0;
        transform: translateY(20px);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        animation: newsLoad 0.6s ease forwards;
        text-align: left;
    }

    .status-section h1 {
        text-align: center;
    }


    .news-card:nth-child(1) {
        animation-delay: 0.15s;
    }

    .news-card:nth-child(2) {
        animation-delay: 0.30s;
    }

    .news-card:nth-child(3) {
        animation-delay: 0.45s;
    }

    .news-card:nth-child(4) {
        animation-delay: 0.60s;
    }

    .news-card:nth-child(5) {
        animation-delay: 0.75s;
    }

    .news-card:nth-child(6) {
        animation-delay: 0.90s;
    }

    .thumb-wrapper {
        position: relative;
        width: 100%;
        height: 180px;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 12px;
    }

    .thumb-parallax {
        position: absolute;
        top: 50%;
        left: 50%;

        width: 120%;
        height: 120%;

        transform: translate(-50%, -50%) translate3d(var(--parallax-x, 0px), var(--parallax-y, 0px), 0);

        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;

        will-change: transform;
    }

    @keyframes newsLoad {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    :root.light .news-card {
        background: rgba(0, 0, 0, 0.5);
    }

    .news-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0 12px var(--text-color);
    }

    .news-card h3 a {
        color: var(--text-color);
        text-decoration: none;
        font-size: 1.3rem;
    }

    .news-card h3 a:hover {
        opacity: 0.8;
    }

    .news-date {
        font-size: 0.85rem;
        opacity: 0.7;
        display: block;
        margin-bottom: 10px;
    }

    .news-summary {
        margin-top: 10px;
        font-size: 1rem;
        line-height: 1.45;
        color: var(--text-color);
        opacity: 0.9;
        text-align: left;
    }

    .news-summary p {
        margin: 8px 0;
    }

    .news-summary strong,
    .news-summary b {
        font-weight: 600;
    }

    .news-summary em,
    .news-summary i {
        opacity: 0.9;
    }

    .news-summary a {
        color: var(--text-color);
        opacity: 0.85;
        text-decoration: underline;
        transition: opacity 0.25s ease;
    }

    .news-summary a:hover {
        opacity: 1;
    }

    .news-summary ul,
    .news-summary ol {
        margin: 8px 0 8px 20px;
        padding-left: 18px;
    }

    .news-summary li {
        margin: 4px 0;
    }

    .news-summary code {
        background: rgba(255, 255, 255, 0.1);
        padding: 2px 4px;
        border-radius: 4px;
        font-family: monospace;
        font-size: 0.9rem;
    }

    .news-summary blockquote {
        border-left: 3px solid var(--text-color);
        padding-left: 10px;
        margin: 10px 0;
        opacity: 0.85;
        font-style: italic;
    }

    .news-summary img {
        max-width: 100%;
        border-radius: 8px;
        margin: 10px 0;
    }

    .news-summary hr {
        border: none;
        border-top: 1px solid var(--text-color);
        opacity: 0.25;
        margin: 12px 0;
    }

    @media (max-width: 768px) {
        .news-summary {
            font-size: 0.95rem;
            line-height: 1.4;
        }
    }


    .author-block {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 10px 0 15px 0;
    }

    .author-thumb {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.2);
    }

    .author-info {
        display: flex;
        flex-direction: column;
    }

    .news-author {
        font-size: 0.95rem;
        font-weight: 600;
        opacity: 0.85;
        color: var(--text-color);
    }

    .news-date {
        font-size: 0.8rem;
        opacity: 0.7;
        color: var(--text-color);
    }

    .news-content {
        background: rgba(255, 255, 255, 0.03);
        padding: 18px 22px;
        border-radius: 10px;
        white-space: pre-wrap;
        line-height: 1.55;
        font-size: 1.05rem;
        color: var(--text-color);
        opacity: 0.9;
        text-align: left;
        margin-top: 20px;
        border-left: 4px solid var(--text-color);
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
        font-style: italic;
    }

    .back-link {
        display: inline-block;
        margin-top: 20px;
        color: var(--text-color);
        opacity: 0.8;
        text-decoration: none;
    }

    .back-link:hover {
        opacity: 1;
    }

    .news-thumb {
        width: 100%;
        max-height: 180px;
        object-fit: cover;
        border-radius: 10px;
        margin-bottom: 12px;
    }

    .news-thumb-large {
        width: 100%;
        max-height: 300px;
        object-fit: cover;
        border-radius: 12px;
        margin: 20px 0;
    }

    .news-tags {
        margin: 10px 0;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .tag {
        background: rgba(255, 255, 255, 0.08);
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.8rem;
        opacity: 0.85;
        color: var(--text-color);
        border: 1px solid var(--text-color);
        transition: all 0.25s ease;
    }

    .tag:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 10px var(--text-color);
    }
</style>

<script>
    document.querySelectorAll(".thumb-wrapper").forEach(wrapper => {
        const image = wrapper.querySelector(".thumb-parallax");

        let targetX = 0;
        let targetY = 0;
        let currentX = 0;
        let currentY = 0;

        const strength = 15;
        const smoothing = 0.1;

        wrapper.addEventListener("mousemove", (event) => {
            const rect = wrapper.getBoundingClientRect();

            const x = (event.clientX - rect.left) / rect.width * 2 - 1;
            const y = (event.clientY - rect.top) / rect.height * 2 - 1;

            targetX = x * strength;
            targetY = y * strength;
        });

        wrapper.addEventListener("mouseleave", () => {
            targetX = 0;
            targetY = 0;
        });

        function animate() {
            currentX += (targetX - currentX) * smoothing;
            currentY += (targetY - currentY) * smoothing;

            image.style.setProperty("--parallax-x", `${currentX}px`);
            image.style.setProperty("--parallax-y", `${currentY}px`);

            requestAnimationFrame(animate);
        }

        animate();
    });
</script>

<script>
    const openBtn = document.getElementById("openCreateMenu");
    const menu = document.getElementById("createMenu");
    const overlay = document.getElementById("createMenuOverlay");

    openBtn.addEventListener("click", () => {
        menu.classList.add("open");
        overlay.classList.add("visible");
    });

    overlay.addEventListener("click", () => {
        menu.classList.remove("open");
        overlay.classList.remove("visible");
    });

</script>