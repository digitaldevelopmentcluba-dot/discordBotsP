<link rel="stylesheet" href="/styles/navbar.css">

<header>
    <nav class="navbar">
        <div class="logo">
            <img src="/assets/images/logo.png" alt="Logo Icon" class="logo-icon">
            Digital Development Club
        </div>

        <div class="nav-controls">
            <ul class="nav-links" id="navMenu">
                <li><% if (user) { %>
                        <a href="/logout" class="account-link">
                            <span>
                                <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" 
                                    style="width: 24px; height: 24px; border-radius: 50%; vertical-align: middle;">
                                Logout
                            </span>
                        </a>
                    <% } else { %>
                        <a href="/discord/auth" class="account-link">
                            <span><i class="fa-solid fa-user"></i> Login with Discord</span>
                        </a>
                    <% } %></li>
            </ul>

            <div class="hamburger" onclick="toggleMenu()">
                <span></span>
                <span></span>
                <span></span>
            </div>

            <button class="theme-toggle" onclick="toggleTheme()">
                <i id="themeIcon" class="fas fa-moon"></i>
            </button>
        </div>
    </nav>
</header>

<script>
    const pages = [
        {location: `/`, name: `Home`, icon: `fas fa-home`},
        {location: `/about`, name: `About`, icon: `fas fa-users`},
        {location: `/news`, name: `News`, icon: `fa-solid fa-newspaper`},
        {location: `/coc`, name: `Code of Conduct`, icon: `fa-solid fa-key`},
        {location: `/bylaws`, name: `Bylaws`, icon: `fa-solid fa-book`},
    ]

    let navMenu = document.getElementById(`navMenu`);

    for (let page of pages) {
        let el = document.createElement(`li`)
        el.innerHTML = `<a href="${page.location}"><i class="${page.icon}"></i> ${page.name}</a>`
        navMenu.appendChild(el);
    }
</script>

<script src="/scripts/navbar.js"></script>
