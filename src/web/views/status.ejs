<style>
    h1 {
        margin-bottom: 10px;
        font-size: 32px;
        font-weight: 700;
    }

    .summary {
        margin-bottom: 25px;
        font-size: 18px;
        opacity: 0.9;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 20px;
    }

    .card {
        background: rgba(0,0,0,0.05);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 0 15px rgba(0,0,0,0.25);
        transition: transform 0.15s ease, box-shadow 0.15s ease;

        opacity: 0;
        transform: translateY(20px);
        animation: cardLoad 0.6s ease forwards;
    }

    @keyframes cardLoad {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .card:nth-child(1) { animation-delay: 0.1s; }
    .card:nth-child(2) { animation-delay: 0.2s; }
    .card:nth-child(3) { animation-delay: 0.3s; }
    .card:nth-child(4) { animation-delay: 0.4s; }
    .card:nth-child(5) { animation-delay: 0.5s; }
    .card:nth-child(6) { animation-delay: 0.6s; }

    .card:hover {
        transform: translateY(-3px);
        box-shadow: 0 0 25px rgba(0,0,0,0.35);
    }

    .card h2 {
        margin: 0 0 10px;
        font-size: 22px;
        font-weight: 600;
    }

    .metric {
        margin: 6px 0;
        font-size: 15px;
    }

    .metric span {
        font-weight: 600;
    }

    .ok {
        color: #4caf50;
    }

    .warn {
        color: #ff9800;
    }

    .err {
        color: #f44336;
    }

    .ping {
        color: #03a9f4;
    }

    .mem {
        color: #9c27b0;
    }

    .cpu {
        color: #8bc34a;
    }

    .footer {
        margin-top: 40px;
        text-align: center;
        opacity: 0.5;
        font-size: 14px;
    }
</style>

<div style="margin: 20px;">
     <h1>Bot Status Dashboard</h1>
    <div class="summary">
        Total Shards: <%= shardCount %> • Total Guilds: <%= totalGuilds %>
    </div>

    <div style="margin: 20px">
        <div class="grid">
            <% shards.forEach(s => { %>
                <div class="card">
                    <h2>Shard <%= s.id %></h2>

                    <div class="metric">
                        <span>Status:</span>
                        <span class="<%= s.ready ? 'ok' : 'err' %>">
                            <%= s.ready ? 'Ready' : 'Not Ready' %>
                        </span>
                    </div>

                    <div class="metric">
                        <span>Guilds:</span> <%= s.guilds %>
                    </div>

                    <div class="metric ping">
                        <span>Ping:</span> <%= s.ping %>ms
                    </div>

                    <div class="metric">
                        <span>Uptime:</span> <%= s.uptime %>ms
                    </div>

                    <div class="metric mem">
                        <span>Memory:</span>
                        RSS <%= (s.memory.rss / 1024 / 1024).toFixed(2) %>MB •
                        Heap <%= (s.memory.heapUsed / 1024 / 1024).toFixed(2) %>MB
                    </div>

                    <div class="metric cpu">
                        <span>CPU:</span>
                        User <%= s.cpu.user %>µs • System <%= s.cpu.system %>µs
                    </div>

                    <div class="metric">
                        <span>WS Status:</span> <%= s.wsStatus %>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <div class="footer">
        Dashboard generated at <%= new Date().toLocaleString() %>
    </div>
</div>
