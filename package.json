{
  "name": "discord-bot-template",
  "version": "1.0.0",
  "description": "A Discord bot template created in TypeScript!",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/launch.ts",
    "build": "npm run clean && tsc",
    "start": "node dist/launch.js",
    "clean": "rimraf dist"
  },
  "keywords": ["Discord", "bot", "template"],
  "author": "Breezist",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "discord.js": "^14.26.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "imports": {
    "#src/*": "./dist/*",
    "#utils/*": "./dist/utils/*"
  }
}
